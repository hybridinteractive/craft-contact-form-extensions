{% set elementType = "hybridinteractive\\contactformextensions\\elements\\Submission" %}
{% set selectedSubnavItem = 'submissions' %}
{% extends '_layouts/elementindex' %}

{% set title = "Submissions"|t('contact-form-extensions') %}

{% if crumbs is not defined %}
    {% set crumbs = [
        { label: craft.contactFormExtensions.name, url: url('contact-form-extensions') }
    ] %}
{% endif %}

{% set defaultLimit = 50 %}
{% set limitOptions = [25, 50, 100] %}
{% set limitStorageKey = 'contact-form-extensions-submissions-limit' %}

{% block footer %}
    <div class="flex flex-nowrap" style="align-items: center; gap: 1rem;">
        <div class="flex flex-nowrap" style="align-items: center; gap: 0.5rem;">
            <label for="submissions-limit-select" class="light">{{ 'Per page'|t('contact-form-extensions') }}:</label>
            <select id="submissions-limit-select" class="select" style="width: auto;">
                {% for option in limitOptions %}
                    <option value="{{ option }}">{{ option }}</option>
                {% endfor %}
            </select>
        </div>
        {{ parent() }}
    </div>
{% endblock %}

{% block initJs %}
    (function() {
        const storageKey = '{{ limitStorageKey }}';
        const defaultLimit = {{ defaultLimit }};
        const savedLimit = parseInt(localStorage.getItem(storageKey) || defaultLimit, 10);
        const limit = [25, 50, 100].includes(savedLimit) ? savedLimit : defaultLimit;
        window.__cfeSubmissionsLimit = limit;

        // Craft paginates with settings.batchSize for both limit and offset.
        // Do not set criteria.limit or page 2 will skip rows.
        const originalCreateElementIndex = Craft.createElementIndex;
        Craft.createElementIndex = function(elementType, $container, settings) {
            settings = settings || {};
            settings.batchSize = limit;
            return originalCreateElementIndex.call(this, elementType, $container, settings);
        };
    })();
    {{ parent() }}
{% endblock %}

{% js %}
    (function() {
        const limitSelect = document.getElementById('submissions-limit-select');
        const storageKey = '{{ limitStorageKey }}';
        const defaultLimit = {{ defaultLimit }};

        if (limitSelect) {
            const savedLimit = parseInt(localStorage.getItem(storageKey) || defaultLimit, 10);
            limitSelect.value = [25, 50, 100].includes(savedLimit) ? savedLimit : defaultLimit;

            limitSelect.addEventListener('change', function() {
                const newLimit = parseInt(this.value, 10);
                localStorage.setItem(storageKey, newLimit);
                if (typeof Craft !== 'undefined' && Craft.elementIndex) {
                    Craft.elementIndex.settings.batchSize = newLimit;
                    if (Craft.elementIndex.settings.criteria) {
                        delete Craft.elementIndex.settings.criteria.limit;
                    }
                    Craft.elementIndex.updateElements(true, true);
                }
            });
        }
    })();
{% endjs %}
