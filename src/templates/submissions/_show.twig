{% css %}
    .so-full-details .contact-form-extensions-submission {
        padding: 24px var(--padding);
        background-color: white;
    }
{% endcss %}

{% macro renderValue(value) %}
    {% if value is iterable %}
        <ul>
            {% for key, item in value %}
                <li>
                    {% if key is not same as(loop.index0) %}
                        <strong>{{ key|capitalize }}:</strong>
                    {% endif %}
                    {{ _self.renderValue(item) }}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>{{ value|nl2br }}</p>
    {% endif %}
{% endmacro %}

{% set skipKeys = [
    'formName',
    'toEmail',
    'confirmationSubject',
    'confirmationTemplate',
    'notificationTemplate',
    'disableRecaptcha',
    'disableConfirmation',
    'disableSaveSubmission'
] %}

<div class="contact-form-extensions-submission readable">
    {% if submission %}
        <h3>{{ "Subject"|t('contact-form-extensions') }}</h3>
        <p>{{ submission.subject ?? '' }}</p>

        <h3>{{ "From name"|t('contact-form-extensions') }}</h3>
        <p>{{ submission.fromName ?? '' }}</p>

        <h3>{{ "From email"|t('contact-form-extensions') }}</h3>
        <p>{{ submission.fromEmail ?? '' }}</p>

        {% if messageObject is iterable %}
            {% for key, value in messageObject %}
                {% if key not in skipKeys %}
                    <h3>{{ key|capitalize|t('contact-form-extensions') }}</h3>
                    {{ _self.renderValue(value) }}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% else %}
        <h3>{{ "Submission does not exist or was deleted"|t('contact-form-extensions') }}</h3>
    {% endif %}
</div>
